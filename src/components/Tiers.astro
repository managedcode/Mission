---
import { tiers } from '../data/site';

// Pixel capacity meter: meterTotal cells, the first `fill` of them lit. Built as
// a trusted HTML string and injected with set:html to sidestep the Astro
// nested-.map()-returning-JSX compiler gotcha (see CLAUDE.md). set:html nodes
// aren't scoped, so .plan__cell is styled via :global below.
const meterCells = (fill: number) =>
  Array.from(
    { length: tiers.meterTotal },
    (_, i) => `<i class="plan__cell"${i < fill ? ' data-on' : ''}></i>`
  ).join('');
---

<section class="section tiers" id="patronage" aria-labelledby="tiers-h">
  <div class="wrap">
    <header class="tiers__intro">
      <p class="kicker" data-reveal>{tiers.kicker}</p>
      <h2 class="tiers__heading" id="tiers-h" data-reveal style="--reveal-delay:80ms">
        {tiers.heading}
      </h2>
      <p class="tiers__lede font-serif" data-reveal style="--reveal-delay:160ms">
        {tiers.lede}
      </p>
    </header>

    <ul class="tiers__grid" role="list">
      {
        tiers.plans.map((plan, i) => (
          <li
            class:list={['tiers__plan', { 'is-featured': plan.featured }]}
            role="listitem"
            data-plan={plan.id}
            data-reveal
            style={`--reveal-delay:${240 + i * 90}ms`}
          >
            <article class="plan card">
              <div class="plan__flag">
                {'badge' in plan && plan.badge && (
                  <span class="plan__badge font-pixel">{plan.badge}</span>
                )}
              </div>

              <header class="plan__top">
                <span class="plan__symbol font-pixel" aria-hidden="true">
                  {plan.symbol}
                </span>
                <span
                  class="plan__window"
                  role="img"
                  aria-label={`Service level: ${plan.window} — ${plan.windowNote}`}
                >
                  <svg
                    class="plan__clock"
                    viewBox="0 0 16 16"
                    width="13"
                    height="13"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <rect x="2" y="2" width="12" height="12" />
                    <path d="M8 5v3.4h3" />
                  </svg>
                  <span class="plan__window-val font-mono" aria-hidden="true">
                    {plan.window}
                  </span>
                </span>
              </header>

              <div class="plan__id">
                <h3 class="plan__name font-display">{plan.name}</h3>
                <p class="plan__price">
                  <span class="visually-hidden">
                    {`${plan.name}-grade patronage, roughly ${plan.salary}.`}
                  </span>
                  <span class="plan__amount font-mono" aria-hidden="true">
                    ≈ {plan.salary.toLowerCase()}
                  </span>
                  <span class="plan__period font-mono" aria-hidden="true">
                    {tiers.cardCaption}
                  </span>
                </p>
              </div>

              <p class="plan__blurb font-serif">{plan.blurb}</p>

              <div class="plan__meter">
                <div class="plan__meter-head">
                  <span class="plan__meter-label font-mono">{tiers.meterLabel}</span>
                  <span class="plan__meter-val font-mono">{plan.hours}</span>
                </div>
                <div
                  class="plan__meter-bar"
                  role="img"
                  aria-label={`Reserves about ${plan.hours} maintainer-hours a month`}
                  set:html={meterCells(plan.meterFill)}
                />
              </div>

              <hr class="rule rule--dotted plan__rule" />

              <ul class="plan__features" role="list">
                {plan.features.map((f) => (
                  <li class="plan__feature">
                    <span class="plan__tick" aria-hidden="true" />
                    <span>{f}</span>
                  </li>
                ))}
              </ul>

              <a
                class:list={['btn', 'plan__cta', plan.featured ? 'btn--accent' : 'btn--ghost']}
                href="#apply"
              >
                {plan.cta}
                <span aria-hidden="true">→</span>
              </a>
            </article>
          </li>
        ))
      }
    </ul>

    <ol class="tiers__steps" data-reveal aria-label="How patronage starts">
      {
        tiers.nextSteps.map((step, i) => (
          <li class="tiers__step">
            <span class="tiers__step-n font-pixel">{String(i + 1).padStart(2, '0')}</span>
            <span class="tiers__step-t">{step}</span>
          </li>
        ))
      }
    </ol>

    <p class="tiers__note font-mono" data-reveal>{tiers.note}</p>
  </div>
</section>

<style>
  .tiers {
    border-top: var(--border-px) solid var(--fg);
    background: var(--bg-sunken);
  }

  /* ---------- Intro ---------- */
  .tiers__intro {
    max-width: 52rem;
    margin-inline: auto;
    text-align: center;
    display: grid;
    justify-items: center;
    gap: var(--space-s);
  }
  .tiers__heading {
    font-size: var(--step-5);
    letter-spacing: -0.028em;
  }
  .tiers__lede {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--fg-soft);
    max-width: 46ch;
  }

  /* ---------- Grid ----------
     Three grades. Mobile-first single column; three wide columns from 48rem;
     the recommended card rides a small podium from 64rem. */
  .tiers__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1rem, 0.6rem + 1.4vw, 1.6rem);
    align-items: stretch;
    max-width: 30rem;
    margin: clamp(2.5rem, 1.6rem + 3.4vw, 4rem) auto 0;
  }
  .tiers__plan {
    display: block;
  }

  @media (min-width: 48rem) {
    .tiers__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      max-width: none;
    }
  }

  /* ---------- Card ---------- */
  .plan {
    --plan-tone: color-mix(in srgb, var(--fg-soft) 70%, var(--fg));
    --plan-line: color-mix(in srgb, var(--fg) 72%, var(--bg));
    height: 100%;
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: clamp(0.7rem, 0.5rem + 0.7vw, 1rem);
    padding: clamp(1.2rem, 0.95rem + 1.1vw, 1.7rem);
    background: color-mix(in srgb, var(--bg-raised) 94%, var(--bg) 6%);
    border-color: var(--plan-line);
    box-shadow: 4px 4px 0 color-mix(in srgb, var(--fg) 70%, transparent);
    overflow: visible;
    transition:
      transform 0.16s var(--ease-out),
      box-shadow 0.16s var(--ease-out);
  }
  .plan::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 4px;
    background: var(--plan-tone);
  }
  .plan:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 color-mix(in srgb, var(--fg) 74%, transparent);
  }

  /* Tone ladder: Junior = quiet ink, Mid = phosphor accent (recommended),
     Senior = gold. */
  .is-featured .plan {
    --plan-tone: var(--accent);
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 6%, var(--bg-raised));
    box-shadow: 5px 5px 0 color-mix(in srgb, var(--accent) 50%, var(--fg));
  }
  [data-plan='senior'] .plan {
    --plan-tone: var(--tier-gold);
    border-color: color-mix(in srgb, var(--tier-gold) 78%, var(--fg));
    background: color-mix(in srgb, var(--tier-gold) 4%, var(--bg-raised));
  }

  /* ---------- Recommended flag (reserved slot keeps card tops aligned) ---------- */
  .plan__flag {
    display: flex;
    justify-content: flex-start;
    min-height: 1.55rem;
  }
  .plan__badge {
    font-size: 0.5rem;
    line-height: 1.4;
    letter-spacing: 0.05em;
    color: #0b1a10;
    background: var(--accent);
    padding: 0.5em 0.75em;
    border: var(--border-px) solid var(--fg);
    box-shadow: var(--shadow-px-sm);
  }
  :global(:root[data-theme='dark']) .plan__badge,
  :global(.invert) .plan__badge {
    color: #07140c;
  }

  /* ---------- Top row: symbol + SLA clock ---------- */
  .plan__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .plan__symbol {
    display: inline-grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border: var(--border-px) solid var(--plan-tone);
    box-shadow: 2px 2px 0 var(--plan-tone);
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    font-size: 0.58rem;
    line-height: 1;
    color: color-mix(in srgb, var(--plan-tone) 55%, var(--fg));
  }
  .plan__window {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.32em 0.6em;
    border: 1.5px solid color-mix(in srgb, var(--plan-tone) 55%, var(--hairline-strong, var(--fg)));
    background: color-mix(in srgb, var(--plan-tone) 7%, transparent);
    color: var(--fg-soft);
  }
  .plan__clock {
    color: var(--plan-tone);
    flex: none;
  }
  .plan__window-val {
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--fg);
  }

  /* ---------- Name / salary ---------- */
  .plan__name {
    font-size: clamp(2.1rem, 1.5rem + 1.3vw, 2.9rem);
    letter-spacing: -0.018em;
  }
  .plan__price {
    display: flex;
    flex-direction: column;
    gap: 0.15em;
    margin-top: 0.35rem;
    padding-left: 0.85rem;
    border-left: var(--border-px) solid var(--plan-tone);
  }
  /* The grade NAME is the hero; the salary reads as a quiet mono caption —
     never a giant display number (there is no sticker price). */
  .plan__amount {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.3;
    color: var(--fg-soft);
  }
  /* Tint the salary with the grade tone, but mixed toward --fg so the small
     gold/green caption clears WCAG AA (pure tone is only ~3:1 on the cards). */
  .is-featured .plan__amount,
  [data-plan='senior'] .plan__amount {
    color: color-mix(in srgb, var(--plan-tone) 55%, var(--fg));
  }
  .plan__period {
    font-size: var(--step--2);
    color: var(--fg-faint);
    text-transform: none;
    letter-spacing: 0.01em;
    line-height: 1.4;
  }
  :global(:root[data-theme='dark']) .plan__period,
  :global(.invert) .plan__period {
    color: var(--fg-soft);
  }

  .plan__blurb {
    font-size: var(--step-0);
    line-height: 1.45;
    color: var(--fg-soft);
    margin-top: 0;
  }

  /* ---------- Capacity meter (the signature visual) ---------- */
  .plan__meter {
    display: grid;
    gap: 0.5rem;
  }
  .plan__meter-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
  }
  .plan__meter-label {
    font-size: var(--step--2);
    letter-spacing: 0.03em;
    color: var(--fg-faint);
    text-transform: uppercase;
  }
  :global(:root[data-theme='dark']) .plan__meter-label,
  :global(.invert) .plan__meter-label {
    color: var(--fg-soft);
  }
  .plan__meter-val {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0;
    /* tone, mixed toward --fg for AA (see .plan__amount note) */
    color: color-mix(in srgb, var(--plan-tone) 55%, var(--fg));
    white-space: nowrap;
  }
  /* Flex (not grid repeat(var())) so the cell count is irrelevant to the CSS
     and it renders identically in every browser. */
  .plan__meter-bar {
    display: flex;
    gap: 3px;
  }
  .plan__meter-bar :global(.plan__cell) {
    flex: 1;
    height: 0.62rem;
    border: 1.5px solid color-mix(in srgb, var(--plan-tone) 32%, transparent);
    background: color-mix(in srgb, var(--plan-tone) 8%, transparent);
  }
  .plan__meter-bar :global(.plan__cell[data-on]) {
    border-color: var(--plan-tone);
    background: var(--plan-tone);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--bg) 30%, transparent);
  }

  .plan__rule {
    margin-block: 0.1rem;
    border: 0;
    height: var(--border-px);
    background: color-mix(in srgb, var(--fg) 34%, transparent);
  }

  /* ---------- Features ---------- */
  .plan__features {
    display: grid;
    gap: 0.62rem;
    margin: 0;
    align-content: start;
  }
  .plan__feature {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.65em;
    align-items: start;
    font-size: var(--step--1);
    line-height: 1.35;
    color: var(--fg-soft);
  }
  .plan__tick {
    width: 0.6em;
    height: 0.6em;
    margin-top: 0.4em;
    border: var(--border-px) solid var(--plan-tone);
    background: color-mix(in srgb, var(--plan-tone) 72%, var(--bg-raised));
    box-shadow: 2px 2px 0 color-mix(in srgb, var(--plan-tone) 40%, var(--fg));
    flex: none;
  }
  .is-featured .plan__feature {
    color: var(--fg);
  }

  /* ---------- CTA (pinned to the bottom so all three line up) ---------- */
  .plan__cta {
    width: 100%;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 0.85em;
    padding-bottom: 0.85em;
  }
  [data-plan='senior'] .plan__cta {
    border-color: var(--plan-tone);
    box-shadow: 3px 3px 0 var(--plan-tone);
  }
  [data-plan='senior'] .plan__cta:hover {
    box-shadow: 5px 5px 0 var(--plan-tone);
  }

  /* Podium: lift the recommended card on wide screens. */
  @media (min-width: 64rem) {
    .tiers__plan.is-featured {
      z-index: 1;
    }
    .is-featured .plan {
      transform: translateY(-0.9rem);
    }
    .is-featured .plan:hover {
      transform: translate(-2px, calc(-0.9rem - 2px));
    }
  }

  /* ---------- How it starts ---------- */
  .tiers__steps {
    list-style: none;
    padding: 0;
    margin: clamp(2.25rem, 1.4rem + 3vw, 3.5rem) auto 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: stretch;
    gap: var(--space-s);
    max-width: 60rem;
  }
  .tiers__step {
    flex: 1 1 14rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    border: var(--border-px) solid var(--fg);
    box-shadow: var(--shadow-px-sm);
    background: var(--bg-raised);
    position: relative;
  }
  /* pixel arrow between steps on wider screens */
  .tiers__step:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -1.05rem;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-mono);
    color: var(--accent-deep);
    z-index: 1;
  }
  .tiers__step-n {
    font-size: 0.62rem;
    color: var(--accent-deep);
    flex: none;
  }
  .tiers__step-t {
    font-size: var(--step--1);
    color: var(--fg-soft);
    line-height: 1.35;
  }
  :global(:root[data-theme='dark']) .tiers__step-n {
    color: var(--accent);
  }
  @media (max-width: 52rem) {
    .tiers__steps {
      flex-direction: column;
      align-items: stretch;
    }
    .tiers__step {
      flex: none;
    }
    .tiers__step:not(:last-child)::after {
      content: '↓';
      right: auto;
      left: 50%;
      top: auto;
      bottom: -1.05rem;
      transform: translateX(-50%);
    }
  }

  /* ---------- Note ---------- */
  .tiers__note {
    text-align: center;
    max-width: 46rem;
    margin: clamp(1.75rem, 1.2rem + 2vw, 2.5rem) auto 0;
    font-size: var(--step--2);
    line-height: 1.7;
    color: var(--fg-faint);
  }

  /* Respect reduced motion: no hover transforms (podium lift is static). */
  @media (prefers-reduced-motion: reduce) {
    .plan {
      transition: none;
    }
    .plan:hover {
      transform: none;
      box-shadow: 4px 4px 0 color-mix(in srgb, var(--fg) 70%, transparent);
    }
    .is-featured .plan:hover {
      box-shadow: 5px 5px 0 color-mix(in srgb, var(--accent) 50%, var(--fg));
    }
    @media (min-width: 64rem) {
      .is-featured .plan,
      .is-featured .plan:hover {
        transform: translateY(-0.9rem);
      }
    }
    [data-plan='senior'] .plan:hover {
      box-shadow: 4px 4px 0 color-mix(in srgb, var(--fg) 70%, transparent);
    }
  }
</style>
