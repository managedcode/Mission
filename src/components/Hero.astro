---
import { hero, motto, miniGame, funding } from '../data/site';

// The WebGL commons field reflects real state: the share of the launch goal
// funded biases how many language satellites glow around the open-source planet.
const fundedPct = Math.round((funding.committed / funding.goal) * 100);

// Precompute the headline as a trusted HTML string. Keep the H1 visible at
// first paint: this text is the LCP candidate, so it must not wait for JS reveal.
const lastLineIndex = hero.headlineLines.length - 1;
const headlineHtml = hero.headlineLines
  .map((line, lineIndex) => {
    const isLast = lineIndex === lastLineIndex;
    const words = line
      .map((word) => {
        const innerCls = isLast ? 'hero__word-inner kinetic' : 'hero__word-inner';
        return `<span class="hero__word"><span class="${innerCls}">${word}</span></span>`;
      })
      .join(' ');
    return `<span class="hero__line">${words}</span>`;
  })
  .join(' ');

// Precompute the terminal body as a trusted HTML string (newlines render as
// line breaks inside <pre>). The last line carries a blinking caret.
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
const termRows = hero.terminalLines.slice(0, -1);
const termLast = hero.terminalLines[hero.terminalLines.length - 1];
const terminalHtml =
  termRows
    .map((line) => {
      const cls = line.startsWith('$') ? 'terminal__cmd' : 'terminal__out';
      return `<span class="${cls}">${esc(line)}\n</span>`;
    })
    .join('') + `<span class="terminal__out caret">${esc(termLast)}</span>`;

// Marquee motto. Built as a trusted HTML string and stamped into two identical
// halves so the -50% loop is seamless; each half repeats the motto enough times
// to overflow the widest viewport, so the strip is never an empty green band.
// set:html children (the ◆ separators) are styled via :global in the CSS below.
const mottoWords = motto.words;
const mottoHalf = Array.from({ length: 4 })
  .map(() => mottoWords.map((w) => `${w} <i>◆</i>`).join(' '))
  .join(' ');
---

<section class="hero grain" aria-labelledby="hero-heading">
  <div class="hero__grid-bg" aria-hidden="true"></div>
  <div class="wrap hero__inner">
    <header class="hero__display">
      <p class="kicker" data-reveal>{hero.kicker}</p>
      <h1 class="hero__headline" id="hero-heading" set:html={headlineHtml} />
    </header>

    <div class="hero__row">
      <div class="hero__lead">
        <p class="hero__lede" data-reveal style="--reveal-delay:520ms">{hero.lede}</p>

        <div class="hero__cta" data-reveal style="--reveal-delay:620ms">
          <a class="btn btn--accent" href={hero.primaryCta.href}>
            {hero.primaryCta.label}
            <span aria-hidden="true">→</span>
          </a>
          <a class="btn btn--ghost" href={hero.secondaryCta.href}>{hero.secondaryCta.label}</a>
        </div>

        <ul class="hero__badges" role="list" data-reveal style="--reveal-delay:720ms">
          {hero.badges.map((badge) => <li class="chip chip--dot">{badge}</li>)}
        </ul>

        <button
          class="hero__play"
          type="button"
          data-game-launch
          data-reveal
          style="--reveal-delay:820ms"
        >
          <span class="hero__play-glyph" aria-hidden="true">▶</span>
          <span class="hero__play-text font-pixel">{miniGame.launchCta}</span>
          <span class="hero__play-tag font-mono" aria-hidden="true"
            >{miniGame.footerLabel} · 60s</span
          >
          <span class="visually-hidden"> — {miniGame.footerLabel}, {miniGame.launchHint}</span>
        </button>
      </div>

      <aside class="hero__crest" data-reveal style="--reveal-delay:320ms">
        <div class="crest" data-hero-field data-fund={fundedPct}>
          <canvas class="crest__field" aria-hidden="true"></canvas>
          <div class="crest__planet" aria-hidden="true"></div>
          <ul class="crest__languages" aria-hidden="true">
            {
              hero.languageSatellites.map((language, index) => (
                <li
                  class="crest__language"
                  data-language-satellite
                  style={`--x:${language.x};--y:${language.y};--dx:${language.dx};--dy:${language.dy};--delay:${index * -0.42}s`}
                  title={language.name}
                >
                  <span>{language.label}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <pre
          class="crest__status terminal__body font-mono"
          style={`--terminal-lines:${hero.terminalLines.length}`}
          aria-hidden="true"><code set:html={terminalHtml} /></pre>
      </aside>
    </div>
  </div>

  <div class="hero__marquee" aria-hidden="true">
    <div class="hero__marquee-track">
      <span class="hero__marquee-group font-pixel" set:html={mottoHalf} />
      <span class="hero__marquee-group font-pixel" set:html={mottoHalf} />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    padding-block: clamp(2rem, 1.1rem + 3.2vw, 4.4rem) 0;
    border-bottom: var(--border-px) solid var(--fg);
  }
  .hero__grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--hairline) 1px, transparent 1px),
      linear-gradient(to bottom, var(--hairline) 1px, transparent 1px);
    background-size: 2.5rem 2.5rem;
    mask-image: radial-gradient(120% 80% at 70% 0%, #000 10%, transparent 70%);
    opacity: 0.6;
    pointer-events: none;
  }
  /* Type is the hero: full-bleed display row on top, 2-col content row below.
     This vertical structure removes any chance of the giant H1 overlapping
     the terminal card (the headline now owns its own full-width row). */
  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: clamp(1.35rem, 0.95rem + 2vw, 2.35rem);
    padding-bottom: clamp(2rem, 1.2rem + 3vw, 3.5rem);
  }
  /* Row 2 — supporting text on the left, console on the right. */
  .hero__row {
    display: grid;
    grid-template-columns: minmax(0, var(--phi-major-fr)) minmax(0, var(--phi-minor-fr));
    gap: var(--phi-gap);
    align-items: start;
  }

  /* Type IS the hero — oversized display, full width, near-solid leading. */
  .hero__display {
    width: 100%;
  }
  .hero__headline {
    font-size: var(--step-8);
    line-height: 0.92;
    margin-top: var(--space-m);
    letter-spacing: -0.04em;
  }
  @media (max-width: 56rem) {
    .hero__headline {
      min-height: calc(6 * 0.92em);
    }
  }
  @media (min-width: 44rem) and (max-width: 56rem) {
    .hero__headline {
      min-height: calc(5 * 0.92em);
    }
  }
  @media (max-width: 26rem) {
    .hero__headline {
      min-height: calc(7 * 0.92em);
    }
  }
  /* Keep each scripted line intact on wide screens; allow wrap on small.
     The headline now spans the full inner width, so the longest line
     ("everything has") has the whole row to hold on one line. Below the
     --maxw cap the content box stops growing (~72rem), so an absolute
     ceiling here guarantees the widest line never overflows at 1440–1920px
     while still riding the --step-8 clamp on mid-size screens. */
  @media (min-width: 56rem) {
    :global(.hero__line) {
      white-space: nowrap;
    }
    .hero__headline {
      font-size: min(var(--step-8), 10.2vw, 7.25rem);
      line-height: 0.94;
    }
  }
  /* Headline words are injected via set:html, so these must be :global. */
  :global(.hero__line) {
    display: block;
  }
  :global(.hero__word) {
    display: inline-block;
    vertical-align: bottom;
  }
  :global(.hero__word-inner) {
    display: inline-block;
  }
  /* Last line is the PAIN, so it reads warm amber (never the phosphor green
     rationed to healthy signals). Light theme stays crisp; dark theme gets
     the phosphor glow. */
  :global(.hero__line:last-child .hero__word-inner) {
    color: var(--amber);
    text-shadow: none;
  }
  /* Crisp amber on near-black needs no halo — the heavy glow muddied the
     letterforms. Keep the type sharp in both themes. */
  :global(:root[data-theme='dark'] .hero__line:last-child .hero__word-inner) {
    color: var(--accent-2);
    text-shadow: none;
  }

  .hero__lede {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 38ch;
    margin-top: var(--space-s);
    color: var(--fg-soft);
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    /* enough room that the chunky 8-bit drop-shadows (and the magnetic nudge)
       never collide with the neighbouring button */
    gap: clamp(1.1rem, 0.7rem + 1.4vw, 1.75rem);
    margin-top: var(--space-m);
  }
  .hero__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: var(--space-m);
  }

  /* Arcade launcher — surfaces the signature mini-game in the first viewport
     without competing with the primary CTAs. "Insert coin" energy. */
  .hero__play {
    margin-top: var(--space-m);
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
    padding: 0.55em 0.9em;
    background: transparent;
    color: var(--fg);
    border: var(--border-px) solid var(--hairline-strong);
    box-shadow: var(--shadow-px-sm);
    cursor: pointer;
    transition:
      transform 0.12s var(--ease-out),
      box-shadow 0.12s var(--ease-out),
      border-color 0.2s;
  }
  .hero__play:hover,
  .hero__play:focus-visible {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 var(--fg);
    border-color: var(--fg);
  }
  .hero__play-glyph {
    color: var(--accent);
    font-size: 0.8em;
    animation: blink 1.1s steps(2, start) infinite;
  }
  .hero__play-text {
    font-size: clamp(0.5rem, 0.42rem + 0.35vw, 0.6rem);
    color: var(--fg);
  }
  .hero__play-tag {
    font-size: var(--step--2);
    color: var(--fg-faint);
    padding-left: 0.7em;
    border-left: 1.5px solid var(--hairline-strong);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__play-glyph {
      animation: none;
    }
  }
  .chip--dot::before {
    content: '';
    width: 7px;
    height: 7px;
    background: var(--accent);
    flex: none;
  }

  /* ── The hero emblem — a pixel open-source planet with programming-language
     satellites, plus a slim 3-line mono "mission status" caption below it. */
  .hero__crest {
    --reveal-y: 0px;
    align-self: center;
    width: 100%;
    padding-top: 0;
  }
  .crest {
    position: relative;
    width: 100%;
    /* Reserve a square brand object up-front so the animated field reads as an
       intentional crest instead of a tall, thin canvas artifact. */
    aspect-ratio: 1;
    max-width: clamp(17.5rem, 27vw, 25rem);
    margin-inline: auto;
  }
  /* The lazy WebGL "digital commons" field (app.ts). It paints atmosphere,
     orbit rails, dependency texture and commit sparks. Transparent until the
     field starts, so no-WebGL / no-JS keep the CSS planet + language satellites. */
  .crest__field {
    position: absolute;
    top: -24%;
    left: -18%;
    width: 136%;
    height: 136%;
    max-width: none;
    z-index: 1;
    pointer-events: none;
    opacity: 0;
    image-rendering: auto;
    filter: contrast(1.16) saturate(0.92);
    transform-origin: 50% 50%;
    -webkit-mask-image: radial-gradient(circle at 50% 50%, black 54%, transparent 82%);
    mask-image: radial-gradient(circle at 50% 50%, black 54%, transparent 82%);
    transition: opacity 1.1s var(--ease-out);
  }
  .crest.is-live .crest__field {
    opacity: 0.68;
  }
  /* when the field is live it supplies the glow + motion — stop the halo breathe
     and quiet it so they don't double up into mush */
  .crest.is-live::before {
    animation: none;
    opacity: 0.24;
  }
  @media (prefers-reduced-motion: reduce) {
    .crest__field {
      display: none;
    }
  }
  .crest__planet {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    width: 42%;
    aspect-ratio: 1;
    border: var(--border-px) solid color-mix(in srgb, var(--fg) 72%, transparent);
    background:
      linear-gradient(
        138deg,
        transparent 0 28%,
        color-mix(in srgb, var(--accent) 18%, transparent) 29% 35%,
        transparent 36% 100%
      ),
      linear-gradient(
        24deg,
        transparent 0 48%,
        color-mix(in srgb, var(--gold) 28%, transparent) 49% 55%,
        transparent 56% 100%
      ),
      radial-gradient(
        circle at 38% 34%,
        color-mix(in srgb, var(--fg) 20%, transparent) 0 5%,
        transparent 6%
      ),
      radial-gradient(
        circle at 62% 58%,
        color-mix(in srgb, var(--fg) 18%, transparent) 0 4%,
        transparent 5%
      ),
      radial-gradient(
        circle at 48% 46%,
        color-mix(in srgb, var(--bg) 74%, var(--gold) 26%) 0 58%,
        color-mix(in srgb, var(--gold) 40%, transparent) 59% 68%,
        transparent 69%
      );
    clip-path: polygon(
      38% 0,
      62% 0,
      62% 6%,
      78% 6%,
      78% 15%,
      90% 15%,
      90% 28%,
      98% 28%,
      98% 72%,
      90% 72%,
      90% 85%,
      78% 85%,
      78% 94%,
      62% 94%,
      62% 100%,
      38% 100%,
      38% 94%,
      22% 94%,
      22% 85%,
      10% 85%,
      10% 72%,
      2% 72%,
      2% 28%,
      10% 28%,
      10% 15%,
      22% 15%,
      22% 6%,
      38% 6%
    );
    transform: translate(-50%, -50%);
    pointer-events: none;
    box-shadow:
      inset 0 0 0 0.18rem color-mix(in srgb, var(--bg) 48%, transparent),
      inset -0.85rem -0.7rem 0 color-mix(in srgb, var(--fg) 10%, transparent),
      0.35rem 0.35rem 0 color-mix(in srgb, var(--fg) 22%, transparent),
      0 0 1.4rem color-mix(in srgb, var(--gold) 16%, transparent);
    image-rendering: pixelated;
    /* smooths the desktop cursor-magnet parallax (app.ts initMagnetic) */
    transition: transform 0.3s var(--ease-out);
    will-change: transform;
  }
  .crest__planet::before,
  .crest__planet::after {
    content: '';
    position: absolute;
    background: color-mix(in srgb, var(--accent) 52%, var(--fg) 18%);
    box-shadow:
      0.55rem 0.1rem 0 color-mix(in srgb, var(--accent) 44%, transparent),
      1.1rem 0.26rem 0 color-mix(in srgb, var(--gold) 36%, transparent),
      -0.6rem 1.35rem 0 color-mix(in srgb, var(--fg) 18%, transparent),
      0.2rem 1.58rem 0 color-mix(in srgb, var(--accent) 38%, transparent);
  }
  .crest__planet::before {
    top: 28%;
    left: 20%;
    width: 14%;
    height: 11%;
  }
  .crest__planet::after {
    right: 22%;
    bottom: 29%;
    width: 11%;
    height: 9%;
    opacity: 0.72;
  }
  @media (prefers-reduced-motion: reduce) {
    .crest__planet {
      transition: none;
    }
  }

  .crest__languages {
    position: absolute;
    inset: 0;
    z-index: 3;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
    transform-origin: 50% 50%;
    animation: language-orbit 26s linear infinite;
  }
  .crest__language {
    position: absolute;
    top: calc(50% + var(--y));
    left: calc(50% + var(--x));
    transform: translate(-50%, -50%);
    animation: language-satellite 5.6s ease-in-out infinite;
    animation-delay: var(--delay);
    will-change: transform;
  }
  .crest__language span {
    display: grid;
    min-width: clamp(1.55rem, 1.16rem + 1.2vw, 2.15rem);
    min-height: clamp(1.05rem, 0.86rem + 0.6vw, 1.35rem);
    place-items: center;
    padding: 0.18rem 0.3rem;
    border: 2px solid color-mix(in srgb, var(--fg) 58%, transparent);
    background: color-mix(in srgb, var(--bg) 84%, var(--gold) 16%);
    color: var(--fg);
    box-shadow:
      0.18rem 0.18rem 0 color-mix(in srgb, var(--fg) 34%, transparent),
      inset 0.22rem 0 0 color-mix(in srgb, var(--accent) 64%, transparent);
    font-family: var(--font-pixel);
    font-size: clamp(0.42rem, 0.34rem + 0.24vw, 0.56rem);
    line-height: 1;
    letter-spacing: 0;
    white-space: nowrap;
    transform-origin: 50% 50%;
    animation: language-label-counter 26s linear infinite;
  }
  .crest__language:nth-child(2n) span {
    background: color-mix(in srgb, var(--bg) 82%, var(--accent) 18%);
  }
  .crest__language:nth-child(3n) span {
    border-color: color-mix(in srgb, var(--gold) 64%, var(--fg) 22%);
  }
  @keyframes language-satellite {
    0%,
    100% {
      transform: translate(-50%, -50%);
    }
    50% {
      transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy)));
    }
  }
  @keyframes language-orbit {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes language-label-counter {
    to {
      transform: rotate(-360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .crest__languages,
    .crest__language span {
      animation: none;
    }
    .crest__language {
      animation: none;
    }
  }
  /* a faint patron-gold halo BEHIND the mark — a separate layer, so it never
     blurs the emblem itself. It breathes slowly (composited scale/opacity only):
     "the lights are on" — the one subtle, on-brand kinetic beat on the hero. */
  .crest::before {
    content: '';
    position: absolute;
    inset: -4%;
    z-index: 0;
    background: radial-gradient(
      circle at 50% 46%,
      color-mix(in srgb, var(--gold) 18%, transparent),
      transparent 66%
    );
    pointer-events: none;
    will-change: transform, opacity;
    animation: crest-breathe 5s ease-in-out infinite;
  }
  @keyframes crest-breathe {
    0%,
    100% {
      transform: scale(0.94);
      opacity: 0.7;
    }
    50% {
      transform: scale(1.06);
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .crest::before {
      animation: none;
    }
  }
  :global(:root[data-theme='dark']) .crest::before {
    background: radial-gradient(
      circle at 50% 46%,
      color-mix(in srgb, var(--gold-glow) 18%, transparent),
      transparent 66%
    );
  }
  :global(:root[data-theme='dark']) .crest__planet {
    border-color: color-mix(in srgb, var(--fg) 54%, transparent);
    background:
      linear-gradient(
        138deg,
        transparent 0 28%,
        color-mix(in srgb, var(--accent) 20%, transparent) 29% 35%,
        transparent 36% 100%
      ),
      linear-gradient(
        24deg,
        transparent 0 48%,
        color-mix(in srgb, var(--gold-glow) 24%, transparent) 49% 55%,
        transparent 56% 100%
      ),
      radial-gradient(
        circle at 38% 34%,
        color-mix(in srgb, var(--fg) 22%, transparent) 0 5%,
        transparent 6%
      ),
      radial-gradient(
        circle at 62% 58%,
        color-mix(in srgb, var(--fg) 18%, transparent) 0 4%,
        transparent 5%
      ),
      radial-gradient(
        circle at 48% 46%,
        color-mix(in srgb, var(--fg) 13%, var(--bg) 87%) 0 58%,
        color-mix(in srgb, var(--gold-glow) 32%, transparent) 59% 68%,
        transparent 69%
      );
    box-shadow:
      inset 0 0 0 0.18rem color-mix(in srgb, var(--bg) 40%, transparent),
      inset -0.85rem -0.7rem 0 color-mix(in srgb, var(--fg) 8%, transparent),
      0.35rem 0.35rem 0 color-mix(in srgb, var(--fg) 14%, transparent),
      0 0 1.35rem color-mix(in srgb, var(--gold-glow) 18%, transparent);
  }
  :global(:root[data-theme='dark']) .crest__language span {
    background: color-mix(in srgb, var(--bg) 84%, var(--gold-glow) 16%);
    border-color: color-mix(in srgb, var(--fg) 48%, transparent);
    box-shadow:
      0.18rem 0.18rem 0 color-mix(in srgb, var(--fg) 18%, transparent),
      inset 0.22rem 0 0 color-mix(in srgb, var(--accent) 58%, transparent);
  }

  /* Slim mono status caption — factual "mission status" without the
     generic-terminal chrome. Small, faint, last line keeps the caret. */
  .crest__status {
    margin: clamp(2.1rem, 1.3rem + 1.2vw, 3rem) 0 0;
    padding: 0;
    max-width: 18rem;
    margin-inline: auto;
    min-width: 0;
    font-size: clamp(0.66rem, 0.6rem + 0.28vw, 0.78rem);
    line-height: 1.75;
    letter-spacing: 0.01em;
    min-block-size: calc(var(--terminal-lines, 4) * 1.75em);
    white-space: pre-wrap;
    word-break: break-word;
    color: var(--fg-faint);
  }
  /* Status lines are injected via set:html → :global. */
  :global(.crest__status .terminal__cmd) {
    color: var(--accent-deep);
  }
  :global(:root[data-theme='dark'] .crest__status .terminal__cmd) {
    color: var(--accent);
  }
  :global(.crest__status .terminal__out) {
    color: var(--fg-faint);
  }
  /* Marquee strip */
  .hero__marquee {
    border-top: var(--border-px) solid var(--fg);
    background: var(--accent);
    color: #08160d;
    overflow: hidden;
    padding-block: 0.5rem;
  }
  :global(:root[data-theme='dark']) .hero__marquee {
    color: #06120a;
  }
  .hero__marquee-track {
    display: flex;
    width: max-content;
    animation: hero-marquee 60s linear infinite;
  }
  .hero__marquee-group {
    font-size: clamp(0.62rem, 0.5rem + 0.45vw, 0.8rem);
    letter-spacing: 0.06em;
    white-space: nowrap;
    padding-right: 0.9em;
  }
  /* set:html children aren't scoped → style the ◆ separators globally */
  :global(.hero__marquee-group i) {
    font-style: normal;
    opacity: 0.6;
    margin-inline: 0.6em;
  }
  @keyframes hero-marquee {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__marquee-track {
      animation: none;
    }
  }

  @media (max-width: 56rem) {
    .hero__row {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    /* Stacked: the planet + status read as ONE compact, left-aligned signature
       row — no tall reserved canvas box with empty gaps. */
    .hero__crest {
      order: 2;
      max-width: 100%;
      display: flex;
      align-items: center;
      gap: clamp(0.9rem, 0.4rem + 2.4vw, 1.6rem);
    }
