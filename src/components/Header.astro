---
import { site, nav } from '../data/site';
import GitHubMark from './GitHubMark.astro';
import Logo from './Logo.astro';
---

<header class="site-header" data-header data-scrolled="false">
  <div class="wrap site-header__bar">
    <a class="brand" href="/">
      <Logo size={34} tight decorative />
      <span class="brand__text">
        <span class="brand__name">{site.brand}</span>
        <span class="brand__tag font-pixel">{site.initiativeTag}</span>
      </span>
      <span class="visually-hidden">{site.homeLinkHint}</span>
    </a>

    <nav class="primary-nav" id="primary-nav" aria-label="Primary" data-nav-menu data-open="false">
      <ul role="list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
      <div class="primary-nav__cta">
        <a class="btn btn--accent" href="/#apply">Become a patron</a>
      </div>
    </nav>

    <div class="site-header__actions">
      <a
        class="icon-btn"
        href={site.github}
        target="_blank"
        rel="noopener"
        aria-label="Managed Code on GitHub (opens in new tab)"
      >
        <GitHubMark size={20} />
      </a>
      <button
        class="icon-btn theme-toggle"
        data-theme-toggle
        type="button"
        aria-pressed="false"
        aria-label="Toggle colour theme"
      >
        <span class="theme-toggle__sun" aria-hidden="true">☀</span>
        <span class="theme-toggle__moon" aria-hidden="true">☾</span>
      </button>
      <button
        class="icon-btn nav-toggle"
        data-nav-toggle
        type="button"
        aria-expanded="false"
        aria-controls="primary-nav"
        aria-label="Open menu"
      >
        <span class="nav-toggle__bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    border-bottom: var(--border-px) solid transparent;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(10px) saturate(1.2);
    transition:
      border-color 0.3s var(--ease-out),
      background-color 0.3s var(--ease-out);
  }
  .site-header[data-scrolled='true'] {
    border-bottom-color: var(--fg);
    background: color-mix(in srgb, var(--bg) 94%, transparent);
  }
  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    min-height: 4.25rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }
  .brand:hover .mc-logo {
    color: var(--accent-deep);
  }
  .mc-logo {
    color: var(--fg);
    transition: color 0.2s var(--ease-out);
  }
  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }
  .brand__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.04rem;
    letter-spacing: -0.012em;
    color: var(--fg);
  }
  .brand__tag {
    font-size: 0.44rem;
    color: var(--accent-deep);
    margin-top: 0.42rem;
    letter-spacing: 0.1em;
  }
  :global(:root[data-theme='dark']) .brand__tag {
    color: var(--accent);
  }

  .primary-nav {
    display: flex;
    align-items: center;
    gap: var(--space-l);
  }
  .primary-nav ul {
    display: flex;
    gap: clamp(1rem, 2vw, 1.9rem);
  }
  .primary-nav a {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--fg-soft);
    position: relative;
    padding-block: 0.4em;
    transition: color 0.2s;
  }
  .primary-nav ul a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0.1em;
    width: 100%;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease-out);
  }
  .primary-nav ul a:hover {
    color: var(--fg);
  }
  .primary-nav ul a:hover::after {
    transform: scaleX(1);
  }
  .primary-nav__cta .btn {
    padding: 0.6em 1em;
    box-shadow: var(--shadow-px-sm);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border: var(--border-px) solid transparent;
    color: var(--fg-soft);
    cursor: pointer;
    background: transparent;
    transition:
      color 0.2s,
      border-color 0.2s,
      background-color 0.2s;
  }
  .icon-btn:hover {
    color: var(--fg);
    border-color: var(--fg);
    background: var(--bg-raised);
  }
  /* meet the 44px touch target on coarse pointers */
  @media (pointer: coarse) {
    .icon-btn {
      width: 2.75rem;
      height: 2.75rem;
    }
  }

  .theme-toggle {
    position: relative;
    font-size: 1.1rem;
  }
  .theme-toggle__moon {
    display: none;
  }
  :global(:root[data-theme='dark']) .theme-toggle__sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .theme-toggle__moon {
    display: block;
  }

  .nav-toggle {
    display: none;
  }
  .nav-toggle__bars,
  .nav-toggle__bars::before,
  .nav-toggle__bars::after {
    content: '';
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    transition:
      transform 0.25s var(--ease-out),
      opacity 0.2s;
  }
  .nav-toggle__bars::before {
    transform: translateY(-6px);
  }
  .nav-toggle__bars::after {
    transform: translateY(4px);
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bars {
    background: transparent;
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bars::before {
    transform: rotate(45deg);
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle__bars::after {
    transform: rotate(-45deg);
  }

  @media (max-width: 60rem) {
    .nav-toggle {
      display: inline-grid;
    }
    .primary-nav {
      position: fixed;
      inset: 4.25rem 0 auto 0;
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-m);
      padding: var(--space-l) clamp(1.1rem, 5vw, 3rem) var(--space-xl);
      background: var(--bg);
      border-bottom: var(--border-px) solid var(--fg);
      transform: translateY(-120%);
      visibility: hidden;
      transition:
        transform 0.35s var(--ease-out),
        visibility 0s linear 0.35s;
      max-height: calc(100svh - 4.25rem);
      overflow-y: auto;
    }
    .primary-nav[data-open='true'] {
      transform: translateY(0);
      visibility: visible;
      transition:
        transform 0.35s var(--ease-out),
        visibility 0s;
      box-shadow: var(--shadow-soft);
    }
    .primary-nav ul {
      flex-direction: column;
      gap: var(--space-s);
    }
    .primary-nav a {
      font-size: var(--step-1);
    }
    .primary-nav__cta .btn {
      width: 100%;
      justify-content: center;
      padding: 0.85em 1em;
    }
  }
</style>
