---
import { join, site } from '../data/site';

/* Derive a short, warm mail subject from each card title.
   Keeps the invitation human and specific without inventing visible copy. */
const subjectFor = (title: string) => {
  const role = title
    .replace(/^Recovering from /i, '')
    .replace(/ with fire$/i, '')
    .trim();
  const tidy = role.charAt(0).toUpperCase() + role.slice(1);
  return `Joining the team — ${tidy}`;
};

const mailto = (subject: string) => `mailto:${site.email}?subject=${encodeURIComponent(subject)}`;
const contactHref = `#${join.contact.anchorId}`;

// Per-card identity: a theme-aware accent + a crisp, symmetric pixel glyph
// (solid silhouettes — bold, low-detail, shape-rendering:crispEdges, no blur).
// Maintainers = green "alive", burnout-recovery = amber "calm", juniors = blue
// "learning". Glyphs precomputed as trusted strings → set:html (CLAUDE.md gotcha).
const roleArt = [
  {
    // wrench — the maintainer's craft
    accent: 'var(--accent)',
    glyph:
      '<rect x="2" y="6" width="2" height="4"/><rect x="3" y="5" width="3" height="1"/><rect x="3" y="10" width="3" height="1"/><rect x="5" y="6" width="3" height="4"/><rect x="8" y="7" width="6" height="2"/>',
  },
  {
    // crescent moon — rest / a calmer orbit
    accent: 'var(--accent-2)',
    glyph:
      '<rect x="6" y="2" width="5" height="1"/><rect x="4" y="3" width="4" height="1"/><rect x="3" y="4" width="3" height="2"/><rect x="2" y="6" width="3" height="4"/><rect x="3" y="10" width="3" height="2"/><rect x="4" y="12" width="4" height="1"/><rect x="6" y="13" width="5" height="1"/>',
  },
  {
    // sprout — juniors growing in the open
    accent: 'var(--accent-3)',
    glyph:
      '<rect x="7" y="4" width="2" height="2"/><rect x="3" y="5" width="3" height="2"/><rect x="10" y="5" width="3" height="2"/><rect x="5" y="7" width="2" height="1"/><rect x="9" y="7" width="2" height="1"/><rect x="7" y="7" width="2" height="7"/>',
  },
] as const;
---

<section class="section join" id="join" aria-labelledby="join-h">
  <div class="wrap join__inner">
    <header class="join__intro">
      <p class="kicker" data-reveal>{join.kicker}</p>
      <h2 class="join__heading" id="join-h" data-reveal style="--reveal-delay:80ms">
        {join.heading}
      </h2>
      <p class="join__lede font-serif" data-reveal style="--reveal-delay:160ms">
        {join.lede}
      </p>
    </header>

    <ul class="join__grid" role="list">
      {
        join.cards.map((card, i) => (
          <li
            class="join__card"
            style={`--role-accent:${roleArt[i % roleArt.length].accent};--reveal-delay:${260 + i * 90}ms`}
            data-reveal
          >
            <span class="join__icon" aria-hidden="true">
              <svg
                class="join__glyph"
                viewBox="0 0 16 16"
                width="24"
                height="24"
                fill="currentColor"
                shape-rendering="crispEdges"
                focusable="false"
                set:html={roleArt[i % roleArt.length].glyph}
              />
            </span>

            <h3 class="join__card-title">{card.title}</h3>
            <p class="join__card-body">{card.body}</p>

            <a
              class="btn btn--ghost join__card-cta"
              href={contactHref}
              data-join-contact-cta
              data-contact-label={card.cta}
              data-contact-subject={subjectFor(card.title)}
            >
              {card.cta}
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div
      class="join__knock"
      id={join.contact.anchorId}
      data-reveal
      data-join-contact-panel
      data-contact-email={site.email}
      tabindex="-1"
    >
      <hr class="rule--dotted join__knock-rule" />
      <p class="join__knock-line">
        <span class="join__knock-label font-pixel">Knock on the door</span>
        <a class="join__knock-mail font-mono" href={mailto(join.contact.generalSubject)}>
          {join.ctaEmailLabel}
          <span class="join__knock-caret caret" aria-hidden="true"></span>
        </a>
      </p>
      <p
        class="join__contact-status font-mono"
        data-join-contact-status
        data-default-status={join.contact.defaultStatus}
        data-selected-prefix={join.contact.selectedPrefix}
        data-copied-prefix={join.contact.copiedPrefix}
        data-copy-fallback-prefix={join.contact.copyFallbackPrefix}
      >
        {join.contact.defaultStatus}
      </p>
    </div>
  </div>
</section>

<style>
  .join {
    border-bottom: var(--border-px) solid var(--fg);
    background: var(--bg);
  }

  .join__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(1.75rem, 1.2rem + 2.2vw, 2.75rem);
  }

  /* ---------- Intro ---------- */
  .join__intro {
    max-width: 52ch;
  }
  .join__heading {
    font-size: var(--step-4);
    margin-top: var(--space-m);
    max-width: 18ch;
  }
  .join__lede {
    font-size: var(--step-1);
    line-height: 1.55;
    margin-top: var(--space-m);
    color: var(--fg-soft);
    max-width: 56ch;
  }

  /* ---------- Cards ---------- */
  .join__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: stretch;
    gap: clamp(1rem, 0.65rem + 1.4vw, 1.75rem);
  }
  .join__card {
    /* Canonical card vocabulary — same 2px ink border + pixel shadow + signature
       diagonal lift as the repo/Tiers cards; a per-card accent left-rule and an
       accent glyph chip give each role its own identity. */
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    min-width: 0;
    background: var(--bg-raised);
    border: var(--border-px) solid var(--fg);
    border-left: 4px solid var(--role-accent, var(--fg));
    box-shadow: var(--shadow-px-sm);
    padding: clamp(1.1rem, 0.9rem + 0.9vw, 1.45rem);
    transition:
      transform 0.16s var(--ease-out),
      box-shadow 0.16s var(--ease-out);
  }
  .join__card:hover,
  .join__card:focus-within {
    transform: translate(-3px, -3px);
    box-shadow: 6px 6px 0 var(--fg);
  }

  .join__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    margin-bottom: var(--space-2xs);
    color: var(--role-accent, var(--accent));
    background: color-mix(in srgb, var(--role-accent, var(--accent)) 12%, var(--bg-sunken));
    border: var(--border-px) solid var(--role-accent, var(--fg));
    box-shadow: 2px 2px 0 color-mix(in srgb, var(--role-accent, var(--fg)) 40%, var(--fg));
  }
  .join__glyph {
    width: 1.5rem;
    height: 1.5rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .join__card {
      transition: none;
    }
    .join__card:hover,
    .join__card:focus-within {
      transform: none;
      box-shadow: var(--shadow-px-sm);
    }
  }

  .join__card-title {
    font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.65rem);
    letter-spacing: -0.02em;
    min-height: 2.08em;
  }
  .join__card-body {
    color: var(--fg-soft);
    font-size: var(--step--1);
    line-height: 1.5;
    max-width: none;
    margin-bottom: 0;
  }
  .join__card-cta {
    align-self: stretch;
    justify-content: space-between;
    width: 100%;
    min-height: 3.5rem;
    margin-top: auto;
    white-space: nowrap;
  }
  .join__card-cta span {
    transition: transform 0.18s var(--ease-out);
  }
  .join__card-cta:hover span {
    transform: translateX(3px);
  }

  /* ---------- Knock on the door ---------- */
  .join__knock {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1rem, 0.75rem + 1vw, 1.5rem);
    scroll-margin-top: calc(var(--header-h) + var(--space-l));
  }
  .join__knock:focus {
    outline: none;
  }
  .join__knock-rule {
    width: 100%;
    max-width: 40rem;
    margin: 0;
  }
  .join__knock-line {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
  }
  .join__knock-label {
    font-size: clamp(0.5rem, 0.42rem + 0.35vw, 0.62rem);
    letter-spacing: 0.04em;
    color: var(--fg-faint);
  }
  .join__knock-mail {
    font-size: var(--step-3);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--fg);
    padding-bottom: 0.12em;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% 2px;
    transition:
      background-size 0.25s var(--ease-out),
      color 0.2s var(--ease-out);
    word-break: break-word;
  }
  /* Thicken the underline on hover — NOT a full-height fill (that turned the
     whole email into a solid green slab). */
  .join__knock-mail:hover,
  .join__knock-mail:focus-visible {
    color: var(--accent-deep);
    background-size: 100% 0.12em;
  }
  :global(:root[data-theme='dark']) .join__knock-mail:hover,
  :global(:root[data-theme='dark']) .join__knock-mail:focus-visible {
    color: var(--accent);
  }
  .join__knock-caret {
    display: inline-block;
  }
  .join__contact-status {
    max-width: 58ch;
    min-height: 1.5em;
    color: var(--fg-soft);
    font-size: var(--step--1);
    line-height: 1.5;
  }
  .join__knock[data-selected='true'] .join__contact-status {
    color: var(--fg);
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 56rem) {
    .join__grid {
      grid-template-columns: 1fr;
    }
    .join__card-body {
      max-width: none;
    }
  }
</style>
