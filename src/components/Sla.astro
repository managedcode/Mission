---
import { sla } from '../data/site';
---

<section class="section sla" id="difference" aria-labelledby="sla-h">
  <div class="wrap">
    <div class="sla__intro" data-reveal>
      <p class="kicker">{sla.kicker}</p>
      <h2 class="sla__heading" id="sla-h">{sla.heading}</h2>
      <p class="sla__lede font-serif">{sla.lede}</p>
    </div>

    <!-- Desktop / wide: semantic comparison table -->
    <div class="sla__tablewrap" data-reveal style="--reveal-delay:120ms">
      <table class="sla__table">
        <caption class="visually-hidden">
          Community goodwill compared with a Mission patronage, across five guarantees.
        </caption>
        <thead>
          <tr>
            <th scope="col" class="sla__corner font-mono">What you get</th>
            <th scope="col" class="sla__colh sla__colh--community font-mono">Community goodwill</th>
            <th scope="col" class="sla__colh sla__colh--patron font-mono">With a patronage</th>
          </tr>
        </thead>
        <tbody>
          {
            sla.rows.map((row) => (
              <tr>
                <th scope="row" class="sla__metric font-mono">
                  {row.metric}
                </th>
                <td class="sla__cell sla__cell--community">
                  <span class="sla__mark sla__mark--no" aria-hidden="true" />
                  <span class="sla__text">{row.community}</span>
                </td>
                <td class="sla__cell sla__cell--patron">
                  <span class="sla__mark sla__mark--yes" aria-hidden="true" />
                  <span class="sla__text">{row.patron}</span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <!-- Mobile: stacked pixel cards (same data, reflowed) -->
    <ul class="sla__cards" role="list">
      {
        sla.rows.map((row, i) => (
          <li class="card sla__card" data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <h3 class="sla__card-title font-mono">{row.metric}</h3>
            <div class="sla__block sla__block--community">
              <p class="sla__label font-pixel">
                <span class="sla__mark sla__mark--no" aria-hidden="true" />
                Community
              </p>
              <p class="sla__block-text">{row.community}</p>
            </div>
            <div class="sla__block sla__block--patron">
              <p class="sla__label font-pixel">
                <span class="sla__mark sla__mark--yes" aria-hidden="true" />
                With Mission
              </p>
              <p class="sla__block-text">{row.patron}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .sla {
    border-bottom: var(--border-px) solid var(--fg);
  }

  /* ---- Intro ---- */
  .sla__intro {
    max-width: 46rem;
    margin-bottom: clamp(2rem, 1rem + 4vw, 3.5rem);
  }
  .sla__heading {
    font-size: var(--step-5);
    margin-top: var(--space-s);
    letter-spacing: -0.026em;
  }
  .sla__lede {
    font-size: var(--step-1);
    line-height: 1.5;
    margin-top: var(--space-m);
    color: var(--fg-soft);
    max-width: 40ch;
  }

  /* ---- Shared pixel markers ---- */
  .sla__mark {
    display: inline-block;
    width: 0.62em;
    height: 0.62em;
    flex: none;
    position: relative;
    top: -0.04em;
    box-shadow: var(--shadow-px-sm);
    box-shadow: 1.5px 1.5px 0 color-mix(in srgb, var(--fg) 55%, transparent);
  }
  /* filled vs. hollow gives a non-colour cue (WCAG 1.4.1) on top of amber/green */
  .sla__mark--yes {
    background: var(--accent);
  }
  .sla__mark--no {
    background: var(--bg-raised);
    box-shadow:
      inset 0 0 0 2px var(--amber),
      1.5px 1.5px 0 color-mix(in srgb, var(--fg) 55%, transparent);
  }

  /* =========================================================
     DESKTOP TABLE
     ========================================================= */
  .sla__tablewrap {
    border: var(--border-px) solid var(--fg);
    box-shadow: var(--shadow-px);
    background: var(--bg-raised);
  }
  .sla__table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }

  .sla__corner,
  .sla__colh {
    text-align: left;
    vertical-align: bottom;
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    padding: 1rem 1.25rem;
    border-bottom: var(--border-px) solid var(--fg);
  }
  .sla__corner {
    width: 26%;
    color: var(--fg-faint);
    background: var(--bg-sunken);
  }
  .sla__colh--community {
    width: 37%;
    color: var(--fg-soft);
  }
  .sla__colh--patron {
    width: 37%;
    color: var(--accent-deep);
    background: color-mix(in srgb, var(--accent) 8%, var(--bg-raised));
    border-left: var(--border-px) solid var(--fg);
  }

  .sla__metric {
    text-align: left;
    vertical-align: top;
    font-size: var(--step--1);
    font-weight: 700;
    line-height: 1.3;
    color: var(--fg);
    padding: 1.1rem 1.25rem;
    background: var(--bg-sunken);
    border-bottom: 1px solid var(--hairline);
  }
  .sla__cell {
    vertical-align: top;
    font-size: var(--step--1);
    line-height: 1.45;
    padding: 1.1rem 1.25rem;
    border-bottom: 1px solid var(--hairline);
  }
  .sla__cell .sla__mark {
    margin-right: 0.6em;
  }
  .sla__cell--community {
    color: var(--fg-soft);
  }
  .sla__cell--patron {
    color: var(--fg);
    font-weight: 500;
    background: color-mix(in srgb, var(--accent) 8%, var(--bg-raised));
    border-left: var(--border-px) solid var(--fg);
  }

  .sla__table tbody tr:last-child .sla__metric,
  .sla__table tbody tr:last-child .sla__cell {
    border-bottom: 0;
  }
  .sla__table tbody tr:hover .sla__metric,
  .sla__table tbody tr:hover .sla__cell--community {
    background: color-mix(in srgb, var(--fg) 4%, var(--bg-raised));
  }

  /* =========================================================
     MOBILE CARDS — hidden on wide screens
     ========================================================= */
  .sla__cards {
    display: none;
  }
  .sla__card {
    padding: clamp(1.1rem, 0.9rem + 1vw, 1.5rem);
  }
  .sla__card + .sla__card {
    margin-top: var(--space-m);
  }
  .sla__card-title {
    font-size: var(--step-0);
    font-weight: 700;
    line-height: 1.25;
    color: var(--fg);
  }
  .sla__block {
    margin-top: var(--space-s);
    padding-top: var(--space-s);
    border-top: 1px solid var(--hairline);
  }
  .sla__block--patron {
    margin-inline: calc(-1 * clamp(1.1rem, 0.9rem + 1vw, 1.5rem));
    margin-bottom: calc(-1 * clamp(1.1rem, 0.9rem + 1vw, 1.5rem));
    padding: var(--space-s) clamp(1.1rem, 0.9rem + 1vw, 1.5rem) clamp(1.1rem, 0.9rem + 1vw, 1.5rem);
    background: color-mix(in srgb, var(--accent) 8%, var(--bg-raised));
    border-top: var(--border-px) solid var(--fg);
  }
  .sla__label {
    display: flex;
    align-items: center;
    gap: 0.55em;
    font-size: clamp(0.5rem, 0.42rem + 0.35vw, 0.58rem);
    letter-spacing: 0.04em;
    color: var(--fg-faint);
  }
  .sla__block--patron .sla__label {
    color: var(--accent-deep);
  }
  .sla__block-text {
    margin-top: 0.6rem;
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--fg-soft);
  }
  .sla__block--patron .sla__block-text {
    color: var(--fg);
    font-weight: 500;
  }

  /* ---- Dark-surface accent legibility ---- */
  :global(:root[data-theme='dark']) .sla__colh--patron,
  :global(:root[data-theme='dark']) .sla__block--patron .sla__label {
    color: var(--accent);
  }

  /* =========================================================
     RESPONSIVE SWAP
     ========================================================= */
  @media (max-width: 48rem) {
    .sla__tablewrap {
      display: none;
    }
    .sla__cards {
      display: block;
    }
  }
</style>
