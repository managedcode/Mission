---
import '../styles/fonts.css';
import '../styles/global.css';
import { motto, site, seo } from '../data/site';
import Mascot from '../components/Mascot.astro';
import pkg from '../../package.json';
import pressStartFontUrl from '@fontsource/press-start-2p/files/press-start-2p-latin-400-normal.woff2?url';
import spaceGroteskFontUrl from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';

export interface Props {
  title?: string;
  description?: string;
  path?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  path = '/',
  ogImage = seo.ogImage,
  noindex = false,
  jsonLd = [],
} = Astro.props;

const pageTitle = title ? `${title} · ${site.name} by ${site.org}` : seo.defaultTitle;
const canonical = new URL(path, site.url).href;
const ogImageUrl = new URL(ogImage, site.url).href;
const sourceComment = `<!--
  ◂▸  ManagedCode · MISSION

  You read the source. Respect — that is exactly the kind of person we hire.
  We staff a team of maintainers for the open source you depend on.

    we are hiring  ->  opensource@managed-code.com
    the code       ->  github.com/managedcode
    the goal       ->  $32,768/mo   (2^15, for the people who would notice)
    the humans     ->  /humans.txt
    the secret     ->  up up down down left right left right B A  --  start
                       (also: click the little maintainer in the corner)

  ${motto.sentence}
-->`;

const baseGraph: Record<string, unknown>[] = [
  {
    '@type': 'Organization',
    '@id': `${site.url}/#org`,
    name: `${site.org} · ${site.name}`,
    alternateName: 'Managed Code Mission',
    url: `${site.url}/`,
    logo: `${site.url}/icon-512.png`,
    image: `${site.url}/og.png`,
    sameAs: [site.github, site.parentSite],
    email: site.email,
    description: site.shortDescription,
    slogan: site.tagline,
  },
  {
    '@type': 'WebSite',
    '@id': `${site.url}/#website`,
    url: `${site.url}/`,
    name: `${site.name} by ${site.org}`,
    description: site.shortDescription,
    inLanguage: 'en',
    publisher: { '@id': `${site.url}/#org` },
  },
];

const graph = [...baseGraph, ...jsonLd];
const structuredData = { '@context': 'https://schema.org', '@graph': graph };
const analyticsEnabled = import.meta.env.PROD;
const googleTagId = site.analytics.googleTagId;
const clarityProjectId = site.analytics.clarityProjectId;
const analyticsBootstrap = `
(() => {
  if (navigator.webdriver) return;

  const googleTagId = ${JSON.stringify(googleTagId)};
  const clarityProjectId = ${JSON.stringify(clarityProjectId)};
  let loaded = false;

  window.dataLayer = window.dataLayer || [];
  window.gtag =
    window.gtag ||
    function gtag() {
      window.dataLayer.push(arguments);
    };
  window.clarity =
    window.clarity ||
    function clarity() {
      (window.clarity.q = window.clarity.q || []).push(arguments);
    };

  const events = ['pointerdown', 'keydown', 'touchstart', 'scroll'];
  const cleanup = () => {
    events.forEach((eventName) => window.removeEventListener(eventName, loadAnalytics, true));
  };
  const loadAnalytics = () => {
    if (loaded) return;
    loaded = true;
    cleanup();

    const googleTag = document.createElement('script');
    googleTag.async = true;
    googleTag.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(googleTagId);
    document.head.appendChild(googleTag);

    window.gtag('js', new Date());
    window.gtag('config', googleTagId);

    const clarityScript = document.createElement('script');
    clarityScript.async = true;
    clarityScript.src = 'https://www.clarity.ms/tag/' + clarityProjectId;
    document.head.appendChild(clarityScript);
  };
  const scheduleIdleFallback = () => {
    window.setTimeout(() => {
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(loadAnalytics, { timeout: 2500 });
      } else {
        window.setTimeout(loadAnalytics, 0);
      }
    }, 12000);
  };

  events.forEach((eventName) =>
    window.addEventListener(eventName, loadAnalytics, {
      once: true,
      passive: true,
      capture: true,
    })
  );
  if (document.readyState === 'complete') {
    scheduleIdleFallback();
  } else {
    window.addEventListener('load', scheduleIdleFallback, { once: true });
  }
})();
`.trim();
---

<!doctype html>
<html
  lang={site.locale}
  data-analytics={analyticsEnabled ? 'production' : undefined}
  data-away-title={seo.awayTitle}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
      )
    }
    <meta name="keywords" content={seo.keywords.join(', ')} />
    <meta name="author" content={site.org} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f1ece0" />
    <meta name="color-scheme" content="light dark" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={seo.ogImageAlt} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={seo.ogImageAlt} />
    <meta name="twitter:site" content={site.twitter} />
    <meta name="twitter:creator" content={site.twitter} />

    <!-- Icons / manifest -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <link rel="preload" href={spaceGroteskFontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={pressStartFontUrl} as="font" type="font/woff2" crossorigin />

    <!-- No-flash theme + first-load intro arm: runs before paint -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const themeColors = { light: '#f1ece0', dark: '#131109' };
        const syncThemeColor = (theme) => {
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute('content', themeColors[theme] || themeColors.light);
        };
        // Mark JS as available so scroll-reveal styles only hide content when
        // they can actually reveal it again. No-JS / crawlers see everything.
        root.classList.add('js');
        let stored = null;
        try {
          stored = localStorage.getItem('mission-theme');
        } catch {
          /* ignore */
        }
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = stored ?? (prefersDark ? 'dark' : 'light');
        root.setAttribute('data-theme', theme);
        syncThemeColor(theme);

        let introSeen = false;
        try {
          introSeen = sessionStorage.getItem('mc-intro') === '1';
        } catch {
          /* ignore */
        }

        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!navigator.webdriver && !reduceMotion && !introSeen) {
          root.classList.add('intro-run');
        }
      })();
    </script>

    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    {analyticsEnabled && <script is:inline set:html={analyticsBootstrap} />}
  </head>
  <body>
    <Fragment set:html={sourceComment} />
    <Fragment
      set:html={`<!-- build: mission@${pkg.version} · maintained, obviously. that's the whole point. -->`}
    />

    <!-- Intro loader: CRT power-on, once per session. Built by initIntro() in
         app.ts, which removes it instantly under automation (navigator.webdriver),
         reduced-motion, or when already shown this session. The head bootstrap
         arms it before first paint so the loaded page is never covered after it
         has already appeared. -->
    <div class="intro" data-intro aria-hidden="true">
      <div class="intro__crt">
        <pre class="intro__log font-pixel"></pre>
        <div class="intro__meter font-pixel"><span data-intro-pct>00</span>%</div>
      </div>
    </div>

    <a class="skip-link" href="#main">Skip to content</a>
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />

    <Mascot variant="corner" />

    <div class="scroll-progress" aria-hidden="true"><span></span></div>
    <div class="cursor" aria-hidden="true"></div>
    <div class="cursor__ring" aria-hidden="true"></div>
    <div class="crt-overlay" aria-hidden="true"></div>

    <script>
      import '../scripts/app.ts';
    </script>
  </body>
</html>
